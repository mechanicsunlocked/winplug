#!/usr/bin/env python3
"""winplug -- the Omarchy Windows VM from the terminal: start it, open it,
and send USB devices into it.

  winplug launch            start Windows if it is off, wait until it answers,
                            open the RDP session.  This is what the Windows
                            app entry and the bar button run.  No password.
      -k, --keep-alive        leave Windows running when the session closes
                              (already the default while autostart is on)
      --stop                  stop Windows afterwards even with autostart on
      --no-connect            start it and return; open it later
  winplug vm start|stop|status
  winplug autostart on|off|status
                            start Windows at boot, in the background

  winplug list              devices on this machine and where they are
  winplug add <device>      send a device to Windows (sticky: survives replugs
                            and VM restarts until removed)
  winplug remove <device>   take it back
  winplug status            one line about the VM and the helper
  winplug doctor            check the whole chain and say what is wrong
  winplug watch             print state changes as they happen

<device> is a vendor:product id (1a86:7523), the number from `winplug list`,
or a unique part of the name.  --json on any command prints the raw state.
"""

import fcntl
import json
import os
import shutil
import socket
import subprocess
import sys
import time

SOCKET = os.environ.get("WINPLUG_SOCKET", "/run/winplug/winplug.sock")
_rdp = os.environ.get("WINPLUG_RDP", "127.0.0.1:3389").rsplit(":", 1)
RDP_HOST, RDP_PORT = _rdp[0], int(_rdp[1])
CREDENTIALS = os.path.expanduser("~/.config/windows/credentials")
KRB5_CONF = os.path.expanduser("~/.config/windows/krb5.conf")
DESKTOP_ENTRY = os.path.expanduser("~/.local/share/applications/windows-vm.desktop")
RDP_TITLE = "Windows VM - Omarchy"
# From "container up" to Windows answering on RDP.  A cold boot on a laptop
# is a minute or two; a Windows update can make it much longer.
START_TIMEOUT = 300
# After Windows ended a session on its own (a reboot, say): how long to wait
# for it to come back before giving up on reconnecting.
RETURN_TIMEOUT = 240

# X.224 Connection Request carrying an RDP negotiation request: the smallest
# thing an RDP listener answers.  Docker's port proxy accepts the TCP
# connection long before Windows listens, so a plain connect proves nothing.
X224_CONNECT = bytes.fromhex("030000130ee000000000000100080003000000")

STATUS_TEXT = {
    "attached": "in Windows",
    "attaching": "sending…",
    "detaching": "removing…",
    "waiting-vm": "will go to Windows when it runs",
    "unplugged": "assigned, not plugged in",
    "no-access": "blocked: restart Windows once",
    "error": "error",
    "available": "on Linux",
}


def die(msg, code=1):
    print("winplug: " + msg, file=sys.stderr)
    sys.exit(code)


class Client:
    def __init__(self, path=SOCKET, timeout=5.0):
        self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.s.settimeout(timeout)
        try:
            self.s.connect(path)
        except FileNotFoundError:
            die("helper socket %s is missing.\n  Is winplugd installed and running?  sudo systemctl status winplugd" % path)
        except PermissionError:
            die("no permission on %s.\n  The helper is configured for another user; check /etc/winplug/winplug.conf" % path)
        except ConnectionRefusedError:
            die("winplugd is not running.  sudo systemctl start winplugd")
        self.buf = b""
        self.state = None

    def read(self):
        while b"\n" not in self.buf:
            chunk = self.s.recv(65536)
            if not chunk:
                die("helper closed the connection")
            self.buf += chunk
        line, self.buf = self.buf.split(b"\n", 1)
        msg = json.loads(line.decode())
        if msg.get("type") == "state":
            self.state = msg
        return msg

    def wait_state(self):
        while self.state is None:
            self.read()
        return self.state

    def request(self, **req):
        self.s.sendall((json.dumps(req) + "\n").encode())
        while True:
            m = self.read()
            if m.get("type") == "reply":
                return m

    def close(self):
        try:
            self.s.close()
        except OSError:
            pass


def req(timeout=5.0, **kw):
    """One request on a fresh connection.  Nothing holds a connection open
    across a long RDP session, where the helper's pushes would pile up."""
    c = Client(timeout=timeout)
    c.wait_state()
    r = c.request(**kw)
    c.close()
    return r


def vm_now():
    c = Client()
    vm = c.wait_state()["vm"]
    c.close()
    return vm


# --------------------------------------------------------------------------
# Devices
# --------------------------------------------------------------------------

def find_device(state, what):
    devs = state["devices"]
    w = what.strip().lower()
    for d in devs:
        if d["key"] == w or d["key"].replace(":", "") == w.replace(":", ""):
            return d
    if w.isdigit():
        i = int(w) - 1
        if 0 <= i < len(devs):
            return devs[i]
        die("no device number %s (there are %d)" % (w, len(devs)))
    matches = [d for d in devs if w in (d.get("name") or "").lower()]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        die("no device matches %r; try `winplug list`" % what)
    die("%r matches several devices: %s" % (what, ", ".join(d["key"] for d in matches)))


def print_list(state):
    devs = state["devices"]
    print(state["vm"]["message"])
    if not devs:
        print("no USB devices")
        return
    w = max(len(d["name"]) for d in devs)
    for i, d in enumerate(devs, 1):
        where = STATUS_TEXT.get(d["status"], d["status"])
        tags = ", ".join(d.get("tags") or [])
        extra = []
        if not d["present"]:
            extra.append("not plugged in")
        if tags:
            extra.append(tags)
        if d.get("count", 1) > 1:
            extra.append("x%d" % d["count"])
        if d.get("detail"):
            extra.append(d["detail"])
        print("%2d  %s  %-*s  %s%s" % (i, d["key"], w, d["name"], where,
                                       ("  (" + "; ".join(extra) + ")") if extra else ""))


def cmd_list(args):
    c = Client()
    st = c.wait_state()
    if "--json" in args:
        print(json.dumps(st, indent=2))
    else:
        print_list(st)


def cmd_status(args):
    c = Client()
    st = c.wait_state()
    if "--json" in args:
        print(json.dumps(st["vm"], indent=2))
        return
    print("%s · %d assigned, %d in Windows · compose %s%s" % (
        st["vm"]["message"], st["assigned_count"], st["attached_count"],
        "has USB access" if st["vm"]["compose_patched"] else "NOT patched",
        " · autostart on" if st["vm"].get("autostart") else ""))


def cmd_change(args, cmd):
    if not args:
        die("which device?  `winplug list` shows them")
    c = Client()
    st = c.wait_state()
    d = find_device(st, args[0])
    r = c.request(cmd="attach" if cmd == "add" else "detach", key=d["key"], name=d.get("name"))
    if not r.get("ok"):
        die(r.get("error", "failed"))
    # Give the helper a moment and report where the device ended up.
    deadline = time.time() + 6
    c.s.settimeout(1.0)
    final = None
    while time.time() < deadline:
        try:
            m = c.read()
        except socket.timeout:
            continue
        if m.get("type") != "state":
            continue
        for e in m["devices"]:
            if e["key"] == d["key"]:
                final = e
        if final and final["status"] in ("attached", "available", "waiting-vm", "unplugged", "no-access", "error"):
            break
    if final is None:
        print("%s: %s" % (d["name"], "sent" if cmd == "add" else "removed"))
    else:
        print("%s: %s%s" % (d["name"], STATUS_TEXT.get(final["status"], final["status"]),
                            (" -- " + final["detail"]) if final.get("detail") else ""))


def cmd_watch(args):
    c = Client(timeout=None)
    while True:
        m = c.read()
        if m.get("type") == "state":
            print(time.strftime("%H:%M:%S"), m["vm"]["message"])
            for d in m["devices"]:
                print("   ", d["key"], d["name"], "->", STATUS_TEXT.get(d["status"], d["status"]))


# --------------------------------------------------------------------------
# Launching Windows
# --------------------------------------------------------------------------

class Say:
    """Progress for a person: lines on the terminal, and notifications when
    there is no terminal (the app entry runs this without one)."""

    def __init__(self):
        self.tty = sys.stderr.isatty()
        self.tool = shutil.which("omarchy-notification-send") or shutil.which("notify-send")

    def __call__(self, headline, body="", urgency="normal", notify=None):
        print(headline + ((": " + body) if body else ""), file=sys.stderr)
        if not self.tool:
            return
        if notify is None:
            notify = not self.tty
        if not notify:
            return
        argv = [self.tool, "--app-name", "Winplug", "-u", urgency, "-r", "91733", headline]
        if body:
            argv.append(body)
        try:
            subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass


# Windows client editions allow one interactive session per user, so a second
# RDP connection as the same account does not open a new window -- Windows
# says "someone is already signed in, sign in as another user?" and the two
# clients fight over the one session.  So launch is single-session: if a
# window is already open (or one is being opened), bring it to the front
# instead of starting a rival connection.

_LAUNCH_LOCK_FD = None


def launch_lock_path():
    rt = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return os.path.join(rt, "winplug-launch.lock")


def acquire_launch_lock():
    """Hold an exclusive lock for the life of this launch.  Returns the fd, or
    None if another launch already holds it (one is mid-flight)."""
    global _LAUNCH_LOCK_FD
    try:
        fd = os.open(launch_lock_path(), os.O_CREAT | os.O_RDWR, 0o600)
    except OSError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    _LAUNCH_LOCK_FD = fd
    return fd


def rdp_window_open():
    """True when some xfreerdp is already connected to this VM's RDP port."""
    target = ("/v:%s:%d" % (RDP_HOST, RDP_PORT)).encode()
    me = os.getpid()
    try:
        pids = os.listdir("/proc")
    except OSError:
        return False
    for pid in pids:
        if not pid.isdigit() or int(pid) == me:
            continue
        try:
            with open("/proc/%s/cmdline" % pid, "rb") as f:
                cmd = f.read()
        except OSError:
            continue
        if b"xfreerdp" in cmd and target in cmd:
            return True
    return False


def focus_rdp_window():
    """Raise the existing Windows window (Hyprland; a no-op elsewhere)."""
    if not shutil.which("hyprctl"):
        return
    try:
        subprocess.run(["hyprctl", "dispatch", "focuswindow", "title:" + RDP_TITLE],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except OSError:
        pass


def rdp_answers(timeout=2.0):
    """True when whatever sits at the RDP port completes an X.224 handshake."""
    try:
        with socket.create_connection((RDP_HOST, RDP_PORT), timeout=timeout) as s:
            s.settimeout(timeout)
            s.sendall(X224_CONNECT)
            data = b""
            while len(data) < 6:
                chunk = s.recv(64)
                if not chunk:
                    break
                data += chunk
    except OSError:
        return False
    return len(data) >= 6 and data[0] == 3 and data[5] == 0xD0


def wait_rdp(timeout, every=1.0, tick=None):
    deadline = time.monotonic() + timeout
    n = 0
    while time.monotonic() < deadline:
        if rdp_answers():
            return True
        n += 1
        if tick:
            tick(n, int(deadline - time.monotonic()))
        time.sleep(every)
    return False


def session_ended_by(rc):
    """Who ended the RDP session, from xfreerdp3's exit code
    (client/X11/xfreerdp.h): 0 success, 2 logoff and 11 disconnect-by-user
    mean the person did; 128 and up mean no session was ever made; the rest
    (1 disconnect, 3-10) mean Windows did: a reboot, another session, idle."""
    if rc in (0, 2, 11):
        return "user"
    if rc >= 128:
        return "nobody"
    return "windows"


def read_credentials():
    """Omarchy's private RDP credentials, with its own fallback."""
    user = password = ""
    try:
        with open(CREDENTIALS) as f:
            for line in f:
                key, _, value = line.rstrip("\n").partition("=")
                if key == "USERNAME":
                    user = value
                elif key == "PASSWORD":
                    password = value
    except OSError:
        pass
    return user or "docker", password or "admin"


def rdp_env():
    """The same realm-less Kerberos config Omarchy's launcher writes, so
    FreeRDP falls straight through to NTLM instead of looking for a KDC."""
    env = dict(os.environ)
    try:
        if not os.path.exists(KRB5_CONF):
            os.makedirs(os.path.dirname(KRB5_CONF), exist_ok=True)
            with open(KRB5_CONF, "w") as f:
                f.write("[libdefaults]\n  dns_lookup_kdc = false\n  dns_lookup_realm = false\n")
        env["KRB5_CONFIG"] = KRB5_CONF
    except OSError:
        pass
    return env


def rdp_scale():
    """Omarchy's rule: HiDPI monitors get a scaled session."""
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=5).stdout
        scale = next((m.get("scale", 1) for m in json.loads(out) if m.get("focused")), 1)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    pct = int(float(scale) * 100)
    if pct >= 170:
        return ["/scale:180"]
    if pct >= 130:
        return ["/scale:140"]
    return []


def run_rdp(user, password):
    """Omarchy's own xfreerdp3 line, flag for flag."""
    argv = ["xfreerdp3", "/u:" + user, "/p:" + password, "/v:%s:%d" % (RDP_HOST, RDP_PORT),
            "-grab-keyboard", "/sound", "/microphone", "/clipboard", "/cert:ignore",
            "/title:" + RDP_TITLE, "/dynamic-resolution", "/gfx:AVC444",
            "/floatbar:sticky:off,default:visible,show:fullscreen"] + rdp_scale()
    try:
        return subprocess.run(argv, env=rdp_env(), stdin=subprocess.DEVNULL).returncode
    except FileNotFoundError:
        die("xfreerdp3 not found (sudo pacman -S freerdp)")


def cmd_launch(args):
    keep = "-k" in args or "--keep-alive" in args
    force_stop = "--stop" in args
    connect = "--no-connect" not in args
    say = Say()
    vm = vm_now()
    if not vm["installed"]:
        die("Windows VM is not installed: omarchy windows vm install")
    if not vm.get("launcher", True):
        die("the helper will not start Windows: omarchy-windows-vm is not a root-owned launcher (winplug doctor)")
    keep = keep or (bool(vm.get("autostart")) and not force_stop)

    # Single-session: never open a second window onto the same VM.
    if connect:
        if rdp_window_open():
            focus_rdp_window()
            print("Windows is already open; brought it to the front.")
            return 0
        if acquire_launch_lock() is None:
            focus_rdp_window()
            print("Windows is already being opened.")
            return 0

    if vm["status"] == "stopping":
        say("Windows is shutting down", "waiting for that to finish first")
        for _ in range(120):
            time.sleep(2)
            vm = vm_now()
            if vm["status"] != "stopping":
                break
    if vm["status"] not in ("running", "running-no-usb"):
        say("Starting Windows", "the session opens when Windows answers; a cold start takes a minute or two")
        r = req(timeout=None, cmd="vm_up")
        if not r.get("ok"):
            say("Windows did not start", r.get("error", "unknown error"), "critical", notify=True)
            return 1
    if not connect:
        print("Windows is %s." % ("running" if vm["status"].startswith("running") else "starting"))
        return 0

    def tick(n, left):
        if n % 30 == 0:
            say("Still waiting for Windows to answer", "%d s left" % left, notify=False)
    if not wait_rdp(START_TIMEOUT, tick=tick):
        say("Windows is not answering",
            "no RDP answer in %d minutes; it is left running, see http://127.0.0.1:8006 and try again"
            % (START_TIMEOUT // 60), "critical", notify=True)
        return 1

    user, password = read_credentials()
    failures = 0
    while True:
        rc = run_rdp(user, password)
        who = session_ended_by(rc)
        if who == "user":
            break
        if who == "nobody":
            failures += 1
            if failures > 4:
                say("Could not connect to Windows",
                    "xfreerdp3 exit code %d after %d tries; Windows is left running" % (rc, failures),
                    "critical", notify=True)
                return 1
            say("Connection failed", "xfreerdp3 exit code %d; trying again" % rc)
            time.sleep(3)
            if not wait_rdp(90):
                say("Windows stopped answering", "it is left running", "critical", notify=True)
                return 1
            continue
        # Windows ended the session itself: a reboot, a shutdown from inside,
        # another session taking over.  Wait for it and open it again.
        say("Windows closed the session", "waiting for it to come back; the session reopens by itself")
        back = False
        deadline = time.monotonic() + RETURN_TIMEOUT
        while time.monotonic() < deadline:
            if rdp_answers():
                back = True
                break
            if vm_now()["status"] in ("off", "not-installed", "unknown"):
                break
            time.sleep(2)
        if not back:
            break
        failures = 0

    # The session is over.  Leave a running Windows alone unless it should
    # stop now; tidy up after one that shut itself down.
    vm = vm_now()
    if vm["status"] not in ("running", "running-no-usb", "starting"):
        if vm.get("container_status") in ("exited", "created", "dead"):
            req(timeout=None, cmd="vm_down")
        print("Windows is off.")
        return 0
    if keep:
        print("Windows keeps running%s." % (" (autostart is on)" if vm.get("autostart") and not force_stop else ""))
        return 0
    say("Stopping Windows", notify=False)
    r = req(timeout=None, cmd="vm_down")
    if not r.get("ok"):
        say("Could not stop Windows", r.get("error", "unknown error"), "critical", notify=True)
        return 1
    print("Windows stopped.")
    return 0


def cmd_vm(args):
    what = args[0] if args else "status"
    if what in ("start", "up"):
        vm = vm_now()
        if vm["status"] in ("running", "running-no-usb"):
            print("Windows is already running.")
            return 0
        print("Starting Windows…")
        r = req(timeout=None, cmd="vm_up")
        if not r.get("ok"):
            die(r.get("error", "failed"))
        print("Windows is starting; `winplug launch` opens it once it answers.")
    elif what in ("stop", "down"):
        print("Stopping Windows…")
        r = req(timeout=None, cmd="vm_down")
        if not r.get("ok"):
            die(r.get("error", "failed"))
        print("Windows stopped.")
    elif what == "status":
        vm = vm_now()
        if "--json" in args:
            print(json.dumps(vm, indent=2))
        else:
            print(vm["message"] + (" · autostart on" if vm.get("autostart") else ""))
    else:
        die("winplug vm start|stop|status", 2)
    return 0


def cmd_autostart(args):
    what = args[0] if args else "status"
    if what in ("on", "off"):
        r = req(cmd="set_autostart", on=(what == "on"))
        if not r.get("ok"):
            die(r.get("error", "failed"))
        if what == "on":
            print("Autostart on: Windows starts at boot and keeps running when you close the session.")
            print("Stop it when you want to with: winplug vm stop")
        else:
            print("Autostart off: Windows starts when you open it and stops when you close it.")
    elif what == "status":
        print("autostart is " + ("on" if vm_now().get("autostart") else "off"))
    else:
        die("winplug autostart on|off|status", 2)
    return 0


def desktop_entry_exec():
    try:
        with open(DESKTOP_ENTRY) as f:
            for line in f:
                if line.startswith("Exec="):
                    return line[5:].strip()
    except OSError:
        return None
    return ""


# --------------------------------------------------------------------------
# Doctor
# --------------------------------------------------------------------------

def cmd_doctor(args):
    ok = True
    def check(cond, good, bad):
        nonlocal ok
        print(("  ok   " if cond else "  FAIL ") + (good if cond else bad))
        ok = ok and bool(cond)

    print("winplug doctor")
    active = subprocess.run(["systemctl", "is-active", "winplugd"], capture_output=True, text=True).stdout.strip()
    check(active == "active", "winplugd.service is running", "winplugd.service is %s  (sudo systemctl start winplugd; journalctl -u winplugd)" % (active or "missing"))
    check(os.path.exists(SOCKET), "socket %s exists" % SOCKET, "socket %s missing" % SOCKET)
    check(os.access(SOCKET, os.W_OK) if os.path.exists(SOCKET) else False,
          "this user may use the socket", "this user cannot write the socket; the helper is configured for someone else")
    if not os.path.exists(SOCKET) or not os.access(SOCKET, os.W_OK):
        return 1
    c = Client()
    st = c.wait_state()
    vm = st["vm"]
    check(vm["installed"], "Windows VM is installed", "Windows VM not installed: omarchy windows vm install")
    check(vm["compose_patched"], "compose has the USB bind mount and cgroup rule",
          "compose not patched" + (" -- " + vm["message"] if "compose:" in vm["message"] else ""))
    print("  info " + vm["message"])
    if vm["status"] == "running-no-usb":
        check(False, "", "the running VM has no /dev/bus/usb; stop and start Windows once")
    elif vm["status"] == "running":
        check(vm["usb_access"], "the running VM sees /dev/bus/usb", "the running VM has no /dev/bus/usb")
    check("launcher" in vm, "helper speaks this version of the protocol",
          "helper is older than this command; run: sudo .../system/install.sh")
    if "launcher" in vm:
        check(vm["launcher"], "helper can start and stop Windows (root-owned omarchy-windows-vm)",
              "helper refuses to run omarchy-windows-vm as root: not root-owned, or writable by others")
    check(shutil.which("xfreerdp3"), "xfreerdp3 found", "xfreerdp3 missing: sudo pacman -S freerdp")
    check(os.path.exists(CREDENTIALS), "RDP credentials file present",
          "no %s (omarchy windows vm install writes it); falling back to docker/admin" % CREDENTIALS)
    entry = desktop_entry_exec()
    if entry is None:
        print("  info no Windows app entry yet (omarchy windows vm install creates it)")
    else:
        check("winplug launch" in entry, "the Windows app entry runs winplug launch",
              "the Windows app entry runs %r: run install.sh again to rewire it (that path prompts for passwords)" % entry)
    print("  info autostart is %s" % ("on" if vm.get("autostart") else "off"))
    plug = os.path.expanduser("~/.config/omarchy/plugins/io.github.mechanicsunlocked.winplug/manifest.json")
    check(os.path.exists(plug), "bar plugin installed", "bar plugin not installed: see README")
    for d in st["devices"]:
        if d["assigned"]:
            print("  dev  %s %s: %s%s" % (d["key"], d["name"], STATUS_TEXT.get(d["status"], d["status"]),
                                          (" -- " + d["detail"]) if d.get("detail") else ""))
    return 0 if ok else 1


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[0], argv[1:]
    if cmd in ("list", "ls"):
        cmd_list(args)
    elif cmd == "status":
        cmd_status(args)
    elif cmd in ("add", "send", "attach"):
        cmd_change(args, "add")
    elif cmd in ("remove", "rm", "detach"):
        cmd_change(args, "remove")
    elif cmd == "watch":
        cmd_watch(args)
    elif cmd == "doctor":
        return cmd_doctor(args)
    elif cmd in ("launch", "connect", "open", "start"):
        return cmd_launch(args)
    elif cmd == "vm":
        return cmd_vm(args)
    elif cmd == "autostart":
        return cmd_autostart(args)
    else:
        die("unknown command %r; try `winplug help`" % cmd, 2)
    return 0


